{
  "name": "stratigraph",
  "version": "2.2.0",
  "mcpName": "io.github.imashishsharma/stratigraph",
  "description": "Upgrade Spring Boot 2.7→3.5/4.0 (Maven or Gradle) with your tests as the judge, and map large Java/Spring/Angular codebases (architecture, data model, API, hotspots), every claim cited. MCP server included.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "bin": {
    "stratigraph": "dist/cli.js"
  },
  "author": "Ashish Sharma",
  "files": [
    "dist",
    "extractor-checksum.json",
    "stratigraph.config.example.json",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p extractors/typescript/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "stratigraph": "tsx src/cli.ts"
  },
  "dependencies": {
    "@angular/compiler": "^19.2.25",
    "@anthropic-ai/sdk": "^0.115.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^11.10.0",
    "commander": "^12.1.0",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.0",
    "tsx": "^4.19.2",
    "vitest": "^3.2.7"
  },
  "keywords": [
    "spring-boot",
    "spring-boot-upgrade",
    "spring-boot-3",
    "gradle",
    "maven",
    "spring-boot-4",
    "migration",
    "openrewrite",
    "jakarta",
    "java",
    "kotlin",
    "angular",
    "static-analysis",
    "architecture",
    "c4",
    "er-diagram",
    "legacy-code",
    "code-archaeology",
    "mcp",
    "mcp-server",
    "claude-code"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imashishsharma/stratigraph.git"
  },
  "bugs": {
    "url": "https://github.com/imashishsharma/stratigraph/issues"
  },
  "homepage": "https://imashishsharma.github.io/stratigraph/",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
